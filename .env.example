# --- Postgres ---
POSTGRES_USER=laqta
POSTGRES_PASSWORD=laqta_dev_password
POSTGRES_DB=laqta
POSTGRES_PORT=5432
# Used by the API/worker (SQLAlchemy, psycopg driver)
DATABASE_URL=postgresql+psycopg://laqta:laqta_dev_password@postgres:5432/laqta

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=laqta
MINIO_ROOT_PASSWORD=laqta_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host:port the API/worker use to reach MinIO (service name inside docker compose)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=laqta
MINIO_SECRET_KEY=laqta_dev_password
MINIO_BUCKET=laqta-photos
MINIO_SECURE=false

# --- API ---
API_PORT=8000

# --- Matching / face pipeline ---
MATCH_THRESHOLD=0.38
GUEST_FACE_RETENTION_DAYS=30
FACE_MODEL_PACK=buffalo_l
ONNXRUNTIME_PROVIDER=CPUExecutionProvider
MIN_FACE_BBOX_PX=40
MIN_DET_SCORE=0.5
