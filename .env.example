# --- Postgres ---
POSTGRES_USER=laqta
POSTGRES_PASSWORD=laqta_dev_password
POSTGRES_DB=laqta
POSTGRES_PORT=5432
# Used by the API/worker (SQLAlchemy, psycopg driver)
DATABASE_URL=postgresql+psycopg://laqta:laqta_dev_password@postgres:5432/laqta

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=laqta
MINIO_ROOT_PASSWORD=laqta_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host:port the API/worker use to reach MinIO (service name inside docker compose)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=laqta
MINIO_SECRET_KEY=laqta_dev_password
MINIO_BUCKET=laqta-photos
MINIO_SECURE=false
SIGNED_URL_TTL_SECONDS=300
# Interval loop, not wall-clock cron -- see docker-compose.yml's
# purge-scheduler service. 86400 = daily.
PURGE_INTERVAL_SECONDS=86400

# --- API ---
API_PORT=8000

# --- Matching / face pipeline ---
MATCH_THRESHOLD=0.38
GUEST_FACE_RETENTION_DAYS=30
FACE_MODEL_PACK=buffalo_l
ONNXRUNTIME_PROVIDER=CPUExecutionProvider
MIN_FACE_BBOX_PX=40
MIN_DET_SCORE=0.5
MIN_BLUR_VARIANCE=100.0
MAX_SELFIE_UPLOAD_BYTES=8388608
MAX_UPLOAD_SPOOL_BYTES=20971520

# --- FTPS ingest (per-event credentials, see docs/plan.md) ---
FTPS_PORT=2121
FTPS_PASSIVE_PORT_START=30000
FTPS_PASSIVE_PORT_END=30009
# Only needed behind NAT/a cloud LB where the container's own address
# isn't what a camera/desktop agent can reach for passive-mode data
# connections. Empty = pyftpdlib uses the control connection's local
# address, correct for local/dev.
FTPS_MASQUERADE_ADDRESS=
